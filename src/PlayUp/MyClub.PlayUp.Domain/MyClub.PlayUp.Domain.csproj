      <NamespaceProvider>False</NamespaceProvider>
    </Folder>
    <Folder Include="Rules\Draw">
      <NamespaceProvider>False</NamespaceProvider>
    </Folder>
    <Folder Include="Rules\Qualification">
      <NamespaceProvider>False</NamespaceProvider>
    </Folder>
    <Folder Include="Rules\Progression">
      <NamespaceProvider>False</NamespaceProvider>
    </Folder>
    <Folder Include="Stages\Feed">
      <NamespaceProvider>False</NamespaceProvider>
    </Folder>
    <Folder Include="Stages\Outcome">
      <NamespaceProvider>False</NamespaceProvider>
    </Folder>
