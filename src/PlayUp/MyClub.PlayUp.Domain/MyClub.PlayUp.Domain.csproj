<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Play'Up competition domain model (aggregates, value objects, domain services).</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MyNet.Generator" />
  </ItemGroup>

