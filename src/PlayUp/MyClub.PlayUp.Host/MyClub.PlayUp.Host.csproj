<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <Description>Play'Up HTTP host (Minimal APIs composition root).</Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CA1515: composition-root types stay public. CA2007: ConfigureAwait noise in ASP.NET request paths. Do not widen. -->
        <NoWarn>$(NoWarn);CA1515;CA2007</NoWarn>
        <UserSecretsId>MyClub.PlayUp.Host</UserSecretsId>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Serilog.AspNetCore" />
        <PackageReference Include="Serilog.Formatting.Compact" />
    </ItemGroup>

    <ItemGroup>
        <!-- H-02: Host binds Domain types at the HTTP edge (ids, Rules enums/specs). Keep explicit — do not rely on transitive refs alone. -->
        <ProjectReference Include="..\MyClub.PlayUp.Domain\MyClub.PlayUp.Domain.csproj" />
        <ProjectReference Include="..\MyClub.PlayUp.Application\MyClub.PlayUp.Application.csproj" />
        <ProjectReference Include="..\MyClub.PlayUp.Infrastructure\MyClub.PlayUp.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Media\MyClub.Media.Infrastructure\MyClub.Media.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="appsettings.Development.json">
            <DependentUpon>appsettings.json</DependentUpon>
        </Content>
    </ItemGroup>

</Project>
