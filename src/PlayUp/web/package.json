{
  "name": "playup-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "lint:css": "stylelint \"src/**/*.css\"",
    "typecheck:tests": "tsc -p tsconfig.vitest.json --noEmit",
    "i18n:check": "vitest run src/i18n/localeParity.test.ts",
    "i18n:audit": "node scripts/audit-structure-i18n.mjs",
    "tile:check": "node scripts/tile-family-check.mjs",
    "css:audit": "node scripts/audit-structure-fiche-css.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:stub": "npm run build && playwright test",
    "test:e2e:host": "playwright test -c playwright.host.config.ts",
    "test:e2e:ui": "npm run build && playwright test --ui"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "i18next": "^26.3.6",
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^30.1.3",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
