{
  "name": "playup-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "lint:css": "stylelint \"src/**/*.css\"",
    "typecheck:tests": "tsc -p tsconfig.vitest.json --noEmit",
    "i18n:check": "vitest run src/i18n/localeParity.test.ts",
    "i18n:audit": "node scripts/audit-structure-i18n.mjs",
    "i18n:audit:repo": "node scripts/i18n-key-audit.mjs",
    "i18n:audit:qualify": "node scripts/i18n-key-audit-qualify.mjs",
    "tile:check": "node scripts/tile-family-check.mjs",
    "css:audit": "node scripts/audit-structure-fiche-css.mjs",
    "frontend:audit": "node scripts/frontend-audit.mjs",
    "frontend:module-graph": "node scripts/frontend-module-graph-audit.mjs",
    "frontend:css:qualify": "node scripts/frontend-css-audit-qualify.mjs",
    "css:audit:rider": "node scripts/css-audit-rider.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:stub": "npm run build && playwright test",
    "test:e2e:host": "playwright test -c playwright.host.config.ts",
    "test:e2e:ui": "npm run build && playwright test --ui"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "i18next": "^26.5.11",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
